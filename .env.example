# --- Fournisseur LLM : openrouter | google (AI Studio) | ollama | anthropic ---
LLM_PROVIDER=openrouter
# Nom du modèle chez le fournisseur (voir exemples ci-dessous). Obligatoire.
COMPANION_MODEL=
# Modèle pour les lubies (optionnel, par défaut = COMPANION_MODEL). Mets un modèle plus petit/moins cher.
COMPANION_IDLE_MODEL=
LLM_TEMPERATURE=0.7

# Exemples de COMPANION_MODEL (vérifie les noms et les prix chez le fournisseur) :
#   openrouter : google/gemini-2.5-flash
#   google     : gemini-2.5-flash
#   ollama     : qwen3:4b   (doit supporter les "tools")

# Clés : renseigne seulement celle du fournisseur choisi
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Serveur Minecraft ---
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Compagnon
# Laisse vide pour l'auto-détection, ou force par ex. 1.21.4
MC_VERSION=

# --- Sécurité ---
# Si défini, seul ce joueur peut donner des ordres au compagnon (mets ton pseudo)
OWNER_USERNAME=
# Zone protégée où le bot ne casse rien tout seul (optionnel)
# HOME_X=0
# HOME_Y=64
# HOME_Z=0
# HOME_RADIUS=20
# true = construit sans demander "oui/non"
AUTO_APPROVE_BUILDS=false

# --- Autonomie (lubies) ---
IDLE_ENABLED=true
IDLE_AFTER_SECONDS=90
IDLE_COOLDOWN_SECONDS=180

# --- Personnalité (optionnel) ---
# PERSONALITY=Tu es Bob, ...
